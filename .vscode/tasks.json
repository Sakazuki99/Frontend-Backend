{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve frontend",
            "type": "process",
            "command": "py",
            "args": [
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1",
                "--directory",
                "${workspaceFolder}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "background": {
                    "activeOnStart": true,
                    "endsPattern": "^Serving HTTP on .* port 8080"
                }
            }
        }
    ]
}
